; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="작은 마을 · 대화 데모"
run/main_scene="res://scenes/demo_map.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=960
window/size/window_height_override=720

[input]
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":32)]}
debug_coordinates={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":56)]}
reload_content={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":57)]}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08,0.12,0.12,1)
